# Copy this file to .env.local and fill in real values. Never commit .env.local — it is
# already gitignored (see .gitignore: `.env*` with an explicit `!.env.example` exception).

# Supabase project URL (safe to expose to the browser as NEXT_PUBLIC_SUPABASE_URL later,
# when a client-facing Supabase usage is added — not needed for ingestion alone).
SUPABASE_URL=

# Supabase service role key. Server/CLI-only — this key bypasses Row Level Security.
# Never expose it in client code or in a NEXT_PUBLIC_* variable. Only used by
# src/lib/ingestion/ (the CSV -> DB ingestion script), never by src/lib/recommendation/
# or src/app/.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: override the default CSV input paths (defaults to
# ~/Downloads/card_value_cards.csv and ~/Downloads/card_value_benefits.csv).
# CARD_VALUE_CARDS_CSV_PATH=
# CARD_VALUE_BENEFITS_CSV_PATH=
